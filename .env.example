# ===== Base de données =====
# La seule chose à renseigner pour MongoDB : l'adresse de votre base (local, serveur ou MongoDB Atlas).
MONGODB_URI=mongodb://localhost:27017/proservices_crm
# MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/proservices_crm
# 'mongo' (production) ou 'memory' (essai sans base, données perdues à l'arrêt). Par défaut : mongo si MONGODB_URI est défini.
DB_DRIVER=mongo

# ===== Serveur =====
PORT=4000
NODE_ENV=development

# ===== Sécurité =====
# Obligatoire en production : une longue chaîne aléatoire (ex. `openssl rand -hex 32`)
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=12h
# Tentatives de connexion par IP sur 15 minutes
LOGIN_RATE_LIMIT=20

# ===== Premier Super admin (créé au démarrage si la base est vide) =====
ADMIN_EMAIL=admin@proservices.tn
ADMIN_PASSWORD=ChangezMoi2026
ADMIN_NAME=Direction

# ===== Multi-entreprises =====
DEFAULT_TENANT=default

# ===== Connexion unique depuis votre application (optionnel) =====
# Votre backend appelle POST /api/auth/sso avec l'en-tête x-sso-secret
SSO_SECRET=

# ===== Données de démo =====
# Mot de passe donné aux membres importés (bouton « Recharger les données de démo »)
DEMO_PASSWORD=demo1234

# ===== Assistant IA (optionnel) =====
# Sans clé, l'assistant du tableau de bord fonctionne en analyse locale.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
